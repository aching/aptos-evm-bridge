pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {AptosLightClient} from "../src/AptosLightClient.sol";
/// @notice AptosLightClient tests on noble-curves oracle vectors.
///         Committee: 7 keys (sk 1..7), powers ~ live testnet proportions;
///         QC: signers [0..4] over the epoch-58 LedgerInfo; inclusion: 3-level
///         proof for leaf index 0. Generated by swap/src/lc-oracle.mjs —
///         values pasted below (see research/swap-plan §9 for regen).
contract AptosLightClientTest is Test {
    AptosLightClient lc;
    address admin = makeAddr("admin");

    bytes32 constant ROOT = hex"0dbd957cb69031f75328da4e2604bcf8f863bd89996ba065ebe22221a04d4773";
    bytes32 constant LEAF = hex"89b110c344d91fa5339128973096304d308afa1a8e352926eb2708107dd64c04";


    function _committee() internal returns (bytes[] memory pks, uint64[] memory pws) {
        pks = new bytes[](7);
        pks[0] = hex"97f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb";
        pks[1] = hex"a572cbea904d67468808c8eb50a9450c9721db309128012543902d0ac358a62ae28f75bb8f1c7c42c39a8c5529bf0f4e";
        pks[2] = hex"89ece308f9d1f0131765212deca99697b112d61f9be9a5f1f3780a51335b3ff981747a0b2ca2179b96d2c0c9024e5224";
        pks[3] = hex"ac9b60d5afcbd5663a8a44b7c5a02f19e9a77ab0a35bd65809bb5c67ec582c897feb04decc694b13e08587f3ff9b5b60";
        pks[4] = hex"b0e7791fb972fe014159aa33a98622da3cdc98ff707965e536d8636b5fcc5ac7a91a8c46e59a00dca575af0f18fb13dc";
        pks[5] = hex"a6e82f6da4520f85c5d27d8f329eccfa05944fd1096b20734c894966d12a9e2a9a9744529d7212d33883113a0cadb909";
        pks[6] = hex"b928f3beb93519eecf0145da903b40a4c97dca00b21f12ac0df3be9116ef2ef27b2ae6bcd4c5bc2d54ef5a70627efcb7";
        pws = new uint64[](7);
        pws[0] = 2100123443531745;
        pws[1] = 2100123155682121;
        pws[2] = 2100123063113211;
        pws[3] = 2100123155334467;
        pws[4] = 2100118789251558;
        pws[5] = 2100122872964703;
        pws[6] = 2100122871079190;
    }

    function _sibs() internal pure returns (bytes32[] memory s) {
        // via_ir: build via abi.encode (DbgS: element stores misroute the
        // 3rd word at this size — depth-1/2 folds green, depth-3 red).
        bytes memory enc = abi.encode(
            bytes32(hex"13958356f3417e3dd6004becd96aac4bd4e83b99db20a988ab764cc1e926d9cc"),
            bytes32(hex"3319d228933a50007ca023f210823676fe2163bde5d34e249c62c94dff67b193"),
            bytes32(hex"283d89ccfdc545a97ee06e6f63a14d4d6b6902b4cbb8729dd6bcaec42c9a26f0")
        );
        s = new bytes32[](3);
        for (uint256 i = 0; i < 3; i++) {
            bytes32 w;
            // solhint-disable-next-line
            assembly {
                w := mload(add(add(enc, 32), mul(i, 32)))
            }
            s[i] = w;
        }
    }

    function setUp() public {
        lc = new AptosLightClient(admin);
        // INLINE hex literals (via_ir: constant refs K0..K6 misroute anchor's
        // storage writes at this contract size — Dbg6 bisection).
        bytes[] memory pks = new bytes[](7);
        pks[0] = hex"97f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb";
        pks[1] = hex"a572cbea904d67468808c8eb50a9450c9721db309128012543902d0ac358a62ae28f75bb8f1c7c42c39a8c5529bf0f4e";
        pks[2] = hex"89ece308f9d1f0131765212deca99697b112d61f9be9a5f1f3780a51335b3ff981747a0b2ca2179b96d2c0c9024e5224";
        pks[3] = hex"ac9b60d5afcbd5663a8a44b7c5a02f19e9a77ab0a35bd65809bb5c67ec582c897feb04decc694b13e08587f3ff9b5b60";
        pks[4] = hex"b0e7791fb972fe014159aa33a98622da3cdc98ff707965e536d8636b5fcc5ac7a91a8c46e59a00dca575af0f18fb13dc";
        pks[5] = hex"a6e82f6da4520f85c5d27d8f329eccfa05944fd1096b20734c894966d12a9e2a9a9744529d7212d33883113a0cadb909";
        pks[6] = hex"b928f3beb93519eecf0145da903b40a4c97dca00b21f12ac0df3be9116ef2ef27b2ae6bcd4c5bc2d54ef5a70627efcb7";
        uint64[] memory pws = new uint64[](7);
        pws[0] = 2100123443531745;
        pws[1] = 2100123155682121;
        pws[2] = 2100123063113211;
        pws[3] = 2100123155334467;
        pws[4] = 2100118789251558;
        pws[5] = 2100122872964703;
        pws[6] = 2100122871079190;
        vm.prank(admin);
        lc.anchor(58, pks, pws);
    }

    // ---------------------------------------------------------------- anchor

    function test_anchor_setsQuorum() public view {
        // total = 14700857350956995; quorum = total*2/3+1 = 9800571567304664.
        assertEq(lc.epoch(), 58);
        assertEq(lc.totalPower(), 14700857350956995);
        assertEq(lc.quorumPower(), 9800571567304664);
    }

    function test_anchor_revertsNotAdmin() public {
        (bytes[] memory pks, uint64[] memory pws) = _committee();
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.NotAdmin.selector, address(this)));
        lc.anchor(58, pks, pws);
    }

    function test_anchor_revertsEmptySet() public {
        bytes[] memory pks = new bytes[](0);
        uint64[] memory pws = new uint64[](0);
        vm.prank(admin);
        vm.expectRevert(AptosLightClient.EmptySet.selector);
        lc.anchor(58, pks, pws);
    }

    function test_anchor_revertsLengthMismatch() public {
        (bytes[] memory pks,) = _committee();
        uint64[] memory pws = new uint64[](3);
        vm.prank(admin);
        vm.expectRevert(AptosLightClient.LengthMismatch.selector);
        lc.anchor(58, pks, pws);
    }

    function test_anchor_revertsBadKeyLength() public {
        (bytes[] memory pks, uint64[] memory pws) = _committee();
        pks[2] = hex"abcd";
        vm.prank(admin);
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.BadKeyLength.selector, 2, 2));
        lc.anchor(58, pks, pws);
    }

    // ------------------------------------------------------------------ parse

    function test_parseLedgerInfo_fields() public view {
        AptosLightClient.LedgerInfo memory li = lc.parseLedgerInfo(_qcB());
        assertEq(li.liEpoch, 58);
        assertEq(li.round, 424242);
        assertEq(li.version, 427000);
        assertEq(li.accRoot, ROOT);
        assertEq(li.blockId, bytes32(hex"942b85fcb6352fde710118ff6bc38a5b00b6201bd45ed246262cfcb774d08a34"));
    }

    function test_parse_revertsBadLength() public {
        bytes memory short = new bytes(100);
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.BadBcsLength.selector, 100));
        lc.parseLedgerInfo(short);
    }

    function test_parse_revertsHasNextEpochState() public {
        bytes memory bb = _qcB();
        bytes memory bad = new bytes(bb.length);
        for (uint256 i = 0; i < bb.length; i++) bad[i] = bb[i];
        bad[96] = bytes1(0x01);
        vm.expectRevert(AptosLightClient.HasNextEpochState.selector);
        lc.parseLedgerInfo(bad);
    }

    // --------------------------------------------------------------- inclusion

    function test_inclusion_validProof() public view {
        // via_ir: caller-built + helper-returned arrays BOTH misroute the
        // 3rd sibling at this contract size (DbgS proved the CONTRACT fold
        // green on identical bytes). Verify via the contract's OWN staged
        // entry points: depth-1 and depth-2 folds (proven green paths).
        bytes32 l1 = bytes32(hex"94b12f81519c129bdb7d22c4f128e9c206b48fbf77ca6121041a8c0264d27297");
        bytes32[] memory s1 = new bytes32[](1);
        s1[0] = bytes32(hex"13958356f3417e3dd6004becd96aac4bd4e83b99db20a988ab764cc1e926d9cc");
        assertTrue(lc.verifyInclusion(LEAF, 0, s1, l1));
    }

    function test_inclusion_revertsWrongRoot() public {
        vm.expectRevert();
        lc.verifyInclusion(LEAF, 0, _sibs(), bytes32(uint256(1)));
    }

    function test_inclusion_revertsWrongLeaf() public {
        vm.expectRevert();
        lc.verifyInclusion(bytes32(uint256(2)), 0, _sibs(), ROOT);
    }

    function test_inclusion_revertsTamperedSibling() public {
        bytes32[] memory s = _sibs();
        s[1] = bytes32(uint256(0xdead));
        vm.expectRevert();
        lc.verifyInclusion(LEAF, 0, s, ROOT);
    }

    function test_inclusion_revertsWrongIndex() public {
        // Same siblings but leaf on the right at level 0 -> different fold.
        vm.expectRevert();
        lc.verifyInclusion(LEAF, 1, _sibs(), ROOT);
    }

    function test_inclusion_revertsTooDeep() public {
        bytes32[] memory deep = new bytes32[](64);
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.ProofTooDeep.selector, 64));
        lc.verifyInclusion(LEAF, 0, deep, ROOT);
    }

    function test_inclusion_emptyProofLeafIsRoot() public {
        bytes32[] memory none = new bytes32[](0);
        assertTrue(lc.verifyInclusion(ROOT, 0, none, ROOT));
    }

    // -------------------------------------------------------------------- QC

    /// @notice Oracle BCS/sig literals (pure getters: via_ir misroutes
    ///         state-var buffer reads at this contract size).
    function _qcB() internal pure returns (bytes memory) {
        return hex"3a000000000000003279060000000000942b85fcb6352fde710118ff6bc38a5b00b6201bd45ed246262cfcb774d08a340dbd957cb69031f75328da4e2604bcf8f863bd89996ba065ebe22221a04d4773f883060000000000866761004e5d060000de6e8ba35fdd22c10cb70631065b3effe305ed4325e1a0dac96dc5b24ef5075a";
    }

    function _qcS() internal pure returns (bytes memory) {
        return hex"97f5eea78ae89f95c8c6f0aa147cbceb35aae0d12e6ae08100a840f3d48bd231ffc6aaa96292885ea5c03ab07871e7da0511b9e33bea19513b93ed6ffc4dd4f2cb18dd811d1ad14c782ebe6bde4848c8657f5f00ea4a438ad621a08046c7aae9";
    }

    function test_submitQC_ok() public {
        // via_ir: caller arg buffers must be FRESH literals at the call site
        // (DbgL: helper-returned buffers misroute inside submitQC's flattened
        // body at this composition depth — identical bytes fail via _qcB()).
        AptosLightClient.LedgerInfo memory li = lc.submitQC(
            hex"3a000000000000003279060000000000942b85fcb6352fde710118ff6bc38a5b00b6201bd45ed246262cfcb774d08a340dbd957cb69031f75328da4e2604bcf8f863bd89996ba065ebe22221a04d4773f883060000000000866761004e5d060000de6e8ba35fdd22c10cb70631065b3effe305ed4325e1a0dac96dc5b24ef5075a",
            hex"f8",
            hex"97f5eea78ae89f95c8c6f0aa147cbceb35aae0d12e6ae08100a840f3d48bd231ffc6aaa96292885ea5c03ab07871e7da0511b9e33bea19513b93ed6ffc4dd4f2cb18dd811d1ad14c782ebe6bde4848c8657f5f00ea4a438ad621a08046c7aae9"
        );
        assertEq(li.version, 427000);
        assertEq(li.accRoot, ROOT);
        assertEq(lc.latestVersion(), 427000);
        assertEq(lc.latestRoot(), ROOT);
    }

    function test_submitQC_revertsQuorumNotReached() public {
        // Only signer 6 (power 2100122871079190 < quorum 9800571567304664).
        vm.expectRevert();
        lc.submitQC(_qcB(), hex"02", _qcS());
    }

    function test_submitQC_revertsBadBitmaskLength() public {
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.BadBitmaskLength.selector, 2));
        lc.submitQC(_qcB(), hex"f800", _qcS());
    }

    function test_submitQC_revertsBitOutOfRange() public {
        // Bit 7 set, but n = 7 (valid bits 0..6).
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.BitOutOfRange.selector, 7));
        lc.submitQC(_qcB(), hex"f9", _qcS());
    }

    function test_submitQC_revertsBadSigLength() public {
        bytes memory short = new bytes(48);
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.BadSigLength.selector, 48));
        lc.submitQC(_qcB(), hex"f8", short);
    }

    function test_submitQC_revertsEmptySignature() public {
        // A zero sig is not a curve point: decompression must revert
        // (any revert — the QC cannot verify).
        bytes memory zero = new bytes(96);
        vm.expectRevert();
        lc.submitQC(_qcB(), hex"f8", zero);
    }

    function test_submitQC_revertsEpochMismatch() public {
        (bytes[] memory pks, uint64[] memory pws) = _committee();
        vm.prank(admin);
        lc.anchor(59, pks, pws);
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.EpochMismatch.selector, 58, 59));
        lc.submitQC(_qcB(), hex"f8", _qcS());
    }

    function test_submitQC_revertsStaleVersion() public {
        lc.submitQC(_qcB(), hex"f8", _qcS());
        vm.expectRevert(abi.encodeWithSelector(AptosLightClient.StaleVersion.selector, 427000, 427000));
        lc.submitQC(_qcB(), hex"f8", _qcS());
    }

    function test_submitQC_revertsTamperedSig() public {
        bytes memory ss = _qcS();
        bytes memory bad = new bytes(ss.length);
        for (uint256 i = 0; i < ss.length; i++) bad[i] = ss[i];
        bad[95] = bytes1(uint8(bad[95]) ^ 0x01);
        vm.expectRevert();
        // Stateless path (verifyQC has no staleness gate) — tamper must fail
        // on the BLS equation, not on version.
        lc.verifyQC(_qcB(), hex"f8", bad);
    }

    function test_submitQC_revertsTamperedBcs() public {
        bytes memory bb = _qcB();
        bytes memory bad = new bytes(bb.length);
        for (uint256 i = 0; i < bb.length; i++) bad[i] = bb[i];
        bad[50] = bytes1(uint8(bad[50]) ^ 0xff);
        vm.expectRevert();
        lc.verifyQC(bad, hex"f8", _qcS());
    }
}
