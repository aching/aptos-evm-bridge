pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";
import {BlsAptos} from "../src/BlsAptos.sol";

/// @notice BlsAptos tests: seed derivation, XMD determinism, G1 aggregation
///         round-trip via precompiles, and the full aggregate equation on a
///         noble-curves oracle vector (injected as constants — generated by
///         swap/ts oracle script; see research/swap-plan §9).
contract BlsAptosTest is Test {
    function _cp(bytes memory dst, uint256 off, bytes memory s) internal pure {
        for (uint256 i = 0; i < s.length; i++) dst[off + i] = s[i];
    }
    bytes constant G1GEN = hex"0000000000000000000000000000000017f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb0000000000000000000000000000000008b3f481e3aaa0f1a09e30ed741d8ae4fcf5e095d5d00af600db18cb2c04b3edd03cc744a2888ae40caa232946c5e7e1";
    function test_seed_pinned() public pure {
        // seed = SHA3-256("APTOS::LedgerInfo") = 98274d3a... (python hashlib reference).
        bytes memory got = BlsAptos.signingMessage(new bytes(0));
        assertEq(got.length, 32);
        assertEq(
            keccak256(got),
            keccak256(hex"98274d3a1dfd01624eb9df4f2fc4e34fa24f18334a0091ec93d0ea833e1fbaa2")
        );
    }

    function test_hashToG2_matchesNoble() public view {
        // hashToG2('seed||bcs-standin') must equal noble's G2.hashToCurve (POP DST).
        bytes memory h = BlsAptos.hashToG2(bytes('seed||bcs-standin'));
        require(h.length == 256, 'len');
        assertEq(keccak256(h), keccak256(hex""));
    }
    function test_xmd_vector2() public view {
        // expand_message_xmd('x', POP DST, 256) first 32 bytes must be
        // 66aea7dafe84ce5a29f3f5a96fc9cc31f0c6a5a91036b93c2fd625e5eeeff557 (noble reference).
        bytes memory pseudo = BlsAptos.expandXmd(bytes('x'), BlsAptos._DST_pub(), 256);
        bytes memory head = new bytes(32);
        for (uint256 i = 0; i < 32; i++) head[i] = pseudo[i];
        console.logBytes(head);
        assertEq(head, hex'66aea7dafe84ce5a29f3f5a96fc9cc31f0c6a5a91036b93c2fd625e5eeeff557');
    }


    function test_aggregateG1_single() public view {
        // aggregateG1([G1_GEN]) must equal G1_GEN.
        bytes memory agg = BlsAptos.aggregateG1(G1GEN);
        assertEq(keccak256(agg), keccak256(G1GEN));
    }

    function test_debug_pair() public view {
        // Direct pairing equation with the SAME oracle vectors, no library:
        // e(PK,H)*e(G1,-sig)==1 where -sig = (q-1)*sig via 0x0e.
        bytes memory sig = hex"";
        // -sig via G2MSM (q-1)
        bytes memory msmIn = new bytes(288);
        _cp(msmIn, 0, sig);
        bytes memory q1 = hex"73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000000";
        _cp(msmIn, 256, q1);
        (bool okm, bytes memory negSig) = address(0x0e).staticcall(msmIn);
        require(okm && negSig.length == 256, 'msm');
        console.logUint(negSig.length);
        // Now full pairing with pk and h vectors (flat build, direct)
        bytes memory pk = hex"0000000000000000000000000000000004cafe0e4602bb74340d45b931591034894f6be4aae24c4e80931d622636bb4da64804903072c655995b423113f417050000000000000000000000000000000010fc122fcd26b0553cec777cd7e355bf8e4f0c82fa65de862013fb2ab895d668ae02956c677ada7481a9f22a99858d19";
        bytes memory h = hex"";
        bytes memory g1 = hex"0000000000000000000000000000000017f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb0000000000000000000000000000000008b3f481e3aaa0f1a09e30ed741d8ae4fcf5e095d5d00af600db18cb2c04b3edd03cc744a2888ae40caa232946c5e7e1";
        // noble form: e(-PK,H)*e(G1,sig)==1. -PK via G1MSM (q-1).
        bytes memory msmPk = new bytes(160);
        _cp(msmPk, 0, pk);
        bytes memory qq = hex"73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000000";
        _cp(msmPk, 128, qq);
        (bool okm2, bytes memory negPk) = address(0x0c).staticcall(msmPk);
        require(okm2 && negPk.length == 128, 'msm-pk');
        bytes memory input = new bytes(768);
        _cp(input, 0, negPk);
        _cp(input, 128, h);
        _cp(input, 384, g1);
        _cp(input, 512, sig);
        (bool okp, bytes memory out) = address(0x0f).staticcall(input);
        require(okp && out.length == 32, 'pairing');
        console.logUint(uint256(bytes32(out)));
    }
    function test_verifyAggregate_oracleVector() public {
        // Oracle vector (noble-curves, POP DST, message "seed||bcs-standin").
        // sig = H(msg)^sk in G2, pk = sk*G1. Values injected below.
        bytes memory pk = hex"0000000000000000000000000000000004cafe0e4602bb74340d45b931591034894f6be4aae24c4e80931d622636bb4da64804903072c655995b423113f417050000000000000000000000000000000010fc122fcd26b0553cec777cd7e355bf8e4f0c82fa65de862013fb2ab895d668ae02956c677ada7481a9f22a99858d19";
        bytes memory h = hex"";
        bytes memory sig = hex"";
        assertTrue(BlsAptos.verifyAggregate(pk, sig, h));
    }

    function test_verifyAggregate_tamperedFails() public {
        bytes memory pk = hex"0000000000000000000000000000000004cafe0e4602bb74340d45b931591034894f6be4aae24c4e80931d622636bb4da64804903072c655995b423113f417050000000000000000000000000000000010fc122fcd26b0553cec777cd7e355bf8e4f0c82fa65de862013fb2ab895d668ae02956c677ada7481a9f22a99858d19";
        bytes memory h = hex"";
        // Tampered sig: valid-curve point (sig + G2 generator) that is NOT
        // the signature for this message. noble confirms verify() == false.
        // (Flipping raw bytes usually leaves the curve -> precompile revert,
        // which is also a safe failure, but this tests the false path.)
        bytes memory bad = hex"";
        assertTrue(!BlsAptos.verifyAggregate(pk, bad, h));
    }
}
