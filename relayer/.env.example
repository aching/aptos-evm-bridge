# Copy to .env and fill in after deployment. NEVER commit .env.
#
# ⚠️  TESTNET DEMO ONLY. This file holds FOUR live private keys and the web
# server signs with all of them on request (one-click demo). This pattern must
# NEVER touch mainnet or real value: anyone with this file (or HTTP access to
# a server running with it) controls the relayer, the demo user funds, and
# mint/release authority up to the daily caps.
# --- Maroo ---
MAROO_RPC_URL=https://rpc-testnet.maroo.io
MAROO_CHAIN_ID=450815
MAROO_VAULT_ADDRESS=0x...
MAROO_RELAYER_PRIVATE_KEY=0x...
MAROO_CONFIRMATIONS=2
MAROO_START_BLOCK=  # optional: catch-up start (defaults to chain head)
# --- Auto-relay (background loop: attests deposits oldest-first, exactly once) ---
AUTORELAY_ENABLED=1           # 0 = manual relay only (step-by-step narration)
RELAY_POLL_S=60               # safety-net cadence (hot path is deposit-triggered wake-ups)
AUTORELAY_LOOKBACK=2000       # cold-start scan-back (blocks) so downtime deposits are caught
# --- Aptos ---
APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com/v1
APTOS_MODULE_ADDRESS=0x...   # publisher: where okrw_bridge modules live
APTOS_BRIDGE_ADDRESS=0x...   # relayer account (holds bridge Config/Seen)
APTOS_OKRW_METADATA=0x...    # OKRW metadata object address
APTOS_RELAYER_PRIVATE_KEY=...
APTOS_USER_ADDRESS=0x...
APTOS_USER_PRIVATE_KEY=...   # only needed for demo withdraw step 1
# --- Monitoring / paging (optional, testnet demo still benefits) ---
MONITOR_ENABLED=0            # set to 1 to run the background health loop
MONITOR_INTERVAL_S=300       # deep check cadence (conservation, caps, pause)
ALERT_WEBHOOK_URL=           # Slack-compatible webhook; empty = log errors only
ALERT_COOLDOWN_S=3600        # min seconds between pages for the same check
